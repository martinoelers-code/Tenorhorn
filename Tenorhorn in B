<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tenorhorn Griffe üben</title>
<style>
  body{font-family:system-ui,sans-serif;max-width:640px;margin:20px auto;padding:0 12px;background:#f4f1ea;color:#222}
  h1{font-size:1.4rem}
  .card{background:#fff;border-radius:12px;padding:16px;margin-bottom:16px;box-shadow:0 1px 4px #0002}
  #noteName{font-size:3rem;font-weight:700;text-align:center;margin:0}
  svg{display:block;margin:0 auto;background:#fff}
  .valves{display:flex;justify-content:center;gap:20px;margin:16px 0}
  .valve{width:70px;height:70px;border-radius:50%;border:3px solid #444;background:#eee;font-size:1.6rem;font-weight:700;cursor:pointer}
  .valve.on{background:#e0a800;border-color:#7a5a00}
  .row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
  button.act{padding:10px 18px;font-size:1rem;border:0;border-radius:8px;background:#2d6a4f;color:#fff;cursor:pointer}
  button.act.sec{background:#555}
  #msg{text-align:center;min-height:1.6em;font-weight:600;margin-top:10px}
  .ok{color:#1b7a3a}.bad{color:#b00020}
  table{border-collapse:collapse;width:100%;font-size:.95rem}
  td,th{border:1px solid #ccc;padding:4px 8px;text-align:center}
  th{background:#eee}
  label{font-size:.9rem}
</style>
</head>
<body>
<h1>🎺 Tenorhorn – Griffe üben</h1>

<div class="card">
  <div class="row" style="margin-bottom:8px">
    <label>Tonbereich:
      <select id="range">
        <option value="easy">Leicht (Bb2 – F4)</option>
        <option value="all" selected>Alle (F2 – Bb4)</option>
      </select>
    </label>
    <label><input type="checkbox" id="showNames" checked> Notenname anzeigen</label>
  </div>

  <p id="noteName">?</p>
  <svg id="staff" width="300" height="190" viewBox="0 0 300 190"></svg>

  <div class="valves">
    <button class="valve" data-v="1">1</button>
    <button class="valve" data-v="2">2</button>
    <button class="valve" data-v="3">3</button>
  </div>

  <div class="row">
    <button class="act" id="check">Prüfen</button>
    <button class="act sec" id="show">Lösung zeigen</button>
    <button class="act sec" id="next">Nächste Note</button>
  </div>
  <div id="msg"></div>
  <p style="text-align:center" id="score">Richtig: 0 / 0</p>
</div>

<div class="card">
  <h2 style="margin-top:0;font-size:1.1rem">Grifftabelle (klingend)</h2>
  <table id="chart"></table>
</div>

<script>
// Note: Name, Griff (Ventile), Letter, Vorzeichen, Oktave
// Klingende Tonhöhen für B-Tenorhorn (3 Ventile)
const NOTES = [
  ["F2","1+3"],["Gb2","2+3"],["G2","1+2"],["Ab2","1"],["A2","2"],
  ["Bb2","0"],["B2","1+2+3"],["C3","1+3"],["Db3","2+3"],["D3","1+2"],
  ["Eb3","1"],["E3","2"],["F3","0"],["Gb3","2+3"],["G3","1+2"],
  ["Ab3","1"],["A3","2"],["Bb3","0"],["B3","1+2"],["C4","1"],
  ["Db4","2"],["D4","0"],["Eb4","1"],["E4","2"],["F4","0"],
  ["Gb4","2+3"],["G4","1+2"],["Ab4","1"],["A4","2"],["Bb4","0"]
];
const LETTERS = {C:0,D:1,E:2,F:3,G:4,A:5,B:6};

function parse(name){
  const letter = name[0];
  const flat = name.includes("b");
  const oct = parseInt(name.slice(-1));
  return {letter, flat, pos: oct*7 + LETTERS[letter]};
}

function pool(){
  const r = document.getElementById("range").value;
  if(r==="easy"){
    const a = NOTES.findIndex(n=>n[0]==="Bb2");
    const b = NOTES.findIndex(n=>n[0]==="F4");
    return NOTES.slice(a,b+1);
  }
  return NOTES;
}

// Notenlinien (Bassschlüssel): untere Linie = G2 (pos 18)
function drawStaff(name){
  const svg = document.getElementById("staff");
  const bottom = 130, step = 8; // halber Linienabstand = 8px
  let s = "";
  for(let i=0;i<5;i++){
    const y = bottom - i*2*step;
    s += `<line x1="30" x2="270" y1="${y}" y2="${y}" stroke="#222" stroke-width="1.5"/>`;
  }
  s += `<text x="38" y="${bottom-2*step*2+6}" font-size="22" font-weight="700">𝄢</text>`;
  s += `<text x="150" y="182" font-size="11" text-anchor="middle" fill="#666">Bassschlüssel (klingend)</text>`;
  if(name){
    const {pos, flat} = parse(name);
    const y = bottom - (pos-18)*step;
    // Hilfslinien
    if(pos<18){ for(let p=16;p>=pos;p-=2){ const yy=bottom-(p-18)*step; s+=`<line x1="${170-18}" x2="${170+18}" y1="${yy}" y2="${yy}" stroke="#222" stroke-width="1.5"/>`; } }
    if(pos>26){ for(let p=28;p<=pos;p+=2){ const yy=bottom-(p-18)*step; s+=`<line x1="${170-18}" x2="${170+18}" y1="${yy}" y2="${yy}" stroke="#222" stroke-width="1.5"/>`; } }
    if(flat) s += `<text x="${170-34}" y="${y+7}" font-size="22">♭</text>`;
    s += `<ellipse cx="170" cy="${y}" rx="10" ry="7.5" fill="#222" transform="rotate(-15 170 ${y})"/>`;
  }
  svg.innerHTML = s;
}

let current=null, total=0, right=0;
const on = new Set();

function fmt(g){ return g==="0" ? "offen" : g; }

function newNote(){
  const p = pool();
  let n;
  do { n = p[Math.floor(Math.random()*p.length)]; } while(current && n[0]===current[0] && p.length>1);
  current = n;
  on.clear();
  document.querySelectorAll(".valve").forEach(b=>b.classList.remove("on"));
  const disp = n[0].replace("b","♭");
  document.getElementById("noteName").textContent = document.getElementById("showNames").checked ? disp : "?";
  drawStaff(n[0]);
  document.getElementById("msg").textContent = "";
}

function setValves(g){
  on.clear();
  if(g!=="0") g.split("+").forEach(v=>on.add(v));
  document.querySelectorAll(".valve").forEach(b=>b.classList.toggle("on", on.has(b.dataset.v)));
}

function currentGriff(){
  return on.size ? [...on].sort().join("+") : "0";
}

document.querySelectorAll(".valve").forEach(b=>{
  b.addEventListener("click",()=>{
    const v=b.dataset.v;
    on.has(v)?on.delete(v):on.add(v);
    b.classList.toggle("on");
  });
});

document.getElementById("check").onclick=()=>{
  const msg=document.getElementById("msg");
  total++;
  if(currentGriff()===current[1]){
    right++;
    msg.textContent="✅ Richtig!"; msg.className="ok";
    setTimeout(newNote,900);
  } else {
    msg.textContent="❌ Leider falsch – nochmal probieren"; msg.className="bad";
  }
  document.getElementById("score").textContent=`Richtig: ${right} / ${total}`;
};
document.getElementById("show").onclick=()=>{
  setValves(current[1]);
  const msg=document.getElementById("msg");
  msg.textContent="Griff: "+fmt(current[1]); msg.className="";
};
document.getElementById("next").onclick=newNote;
document.getElementById("range").onchange=newNote;
document.getElementById("showNames").onchange=()=>{
  document.getElementById("noteName").textContent = document.getElementById("showNames").checked ? current[0].replace("b","♭") : "?";
};

// Tabelle
(function(){
  let h = "<tr><th>Ton</th><th>Griff</th><th>Ton</th><th>Griff</th></tr>";
  const half = Math.ceil(NOTES.length/2);
  for(let i=0;i<half;i++){
    const a=NOTES[i], b=NOTES[i+half];
    h += `<tr><td>${a[0].replace("b","♭")}</td><td>${fmt(a[1])}</td>` +
         (b?`<td>${b[0].replace("b","♭")}</td><td>${fmt(b[1])}</td>`:"<td></td><td></td>") + "</tr>";
  }
  document.getElementById("chart").innerHTML=h;
})();

drawStaff(null);
newNote();
</script>
</body>
</html>
